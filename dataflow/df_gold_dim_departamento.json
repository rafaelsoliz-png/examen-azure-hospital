{
	"name": "df_gold_dim_departamento",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "SourceSilverAdmissions"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_gold_dim_departamento",
						"type": "DatasetReference"
					},
					"name": "SinkGoldDimDepartamento"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT LTRIM(RTRIM(department)) AS nombre_departamento\\nFROM silver.admissions\\nWHERE department IS NOT NULL',",
				"     format: 'query') ~> SourceSilverAdmissions",
				"SourceSilverAdmissions sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          nombre_departamento",
				"     )) ~> SinkGoldDimDepartamento"
			]
		}
	}
}