{
	"name": "df_silver_billing",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_billing",
						"type": "DatasetReference"
					},
					"name": "SourceBronzeBilling"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_billing",
						"type": "DatasetReference"
					},
					"name": "SinkSilverBilling"
				}
			],
			"transformations": [
				{
					"name": "CleanAndCastBilling"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceBronzeBilling",
				"SourceBronzeBilling derive(billing_id = toInteger(billing_id),",
				"          admission_id = toInteger(admission_id),",
				"          amount = toDecimal(replace(replace(amount, '$', ''), ',', ''), 12, 2),",
				"          payment_date = toDate(payment_date)) ~> CleanAndCastBilling",
				"CleanAndCastBilling sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     truncate:true,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id,",
				"          admission_id,",
				"          charge_type,",
				"          amount,",
				"          payment_status,",
				"          payment_date",
				"     )) ~> SinkSilverBilling"
			]
		}
	}
}