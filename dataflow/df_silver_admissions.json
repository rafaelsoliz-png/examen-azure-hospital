{
	"name": "df_silver_admissions",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_admissions",
						"type": "DatasetReference"
					},
					"name": "SourceBronzeAdmissions"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "SinkSilverAdmissions"
				}
			],
			"transformations": [
				{
					"name": "CleanAndCastAdmissions"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT a.*\\nFROM bronze.admissions a\\nINNER JOIN silver.patients p ON TRY_CAST(a.patient_id AS INT) = p.patient_id\\nWHERE a.admission_date IS NOT NULL AND LTRIM(RTRIM(a.admission_date)) <> \\'\\'',",
				"     format: 'query') ~> SourceBronzeAdmissions",
				"SourceBronzeAdmissions derive(admission_id = toInteger(admission_id),",
				"          patient_id = toInteger(patient_id),",
				"          admission_date = coalesce(toDate(admission_date, 'yyyy-MM-dd'), toDate(admission_date, 'MM-dd-yy'), toDate(admission_date, 'MM/dd/yyyy'), toDate(admission_date, 'dd-MMM-yyyy'), toDate(admission_date, 'MMMM dd, yyyy')),",
				"          discharge_date = coalesce(toDate(discharge_date, 'yyyy-MM-dd'), toDate(discharge_date, 'MM-dd-yy'), toDate(discharge_date, 'MM/dd/yyyy'), toDate(discharge_date, 'dd-MMM-yyyy'), toDate(discharge_date, 'MMMM dd, yyyy')),",
				"          attending_doctor_id = toInteger(attending_doctor_id)) ~> CleanAndCastAdmissions",
				"CleanAndCastAdmissions sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SinkSilverAdmissions"
			]
		}
	}
}