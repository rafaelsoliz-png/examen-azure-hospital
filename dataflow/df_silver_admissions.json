{
	"name": "df_silver_admissions",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_admissions",
						"type": "DatasetReference"
					},
					"name": "SourceBronzeAdmissions"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "SinkSilverAdmissions"
				}
			],
			"transformations": [
				{
					"name": "CleanAndCastAdmissions"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> SourceBronzeAdmissions",
				"SourceBronzeAdmissions derive(admission_id = toInteger(admission_id),",
				"          patient_id = toInteger(patient_id),",
				"          admission_date = toDate(admission_date),",
				"          discharge_date = toDate(discharge_date),",
				"          attending_doctor_id = toInteger(attending_doctor_id)) ~> CleanAndCastAdmissions",
				"CleanAndCastAdmissions sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> SinkSilverAdmissions"
			]
		}
	}
}