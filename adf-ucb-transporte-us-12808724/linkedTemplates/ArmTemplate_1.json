		{
			"name": "[concat(parameters('factoryName'), '/df_gold_dim_servicio_cargo')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_silver_billing",
								"type": "DatasetReference"
							},
							"name": "SourceSilverBilling"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_gold_dim_servicio_cargo",
								"type": "DatasetReference"
							},
							"name": "SinkGoldDimServicioCargo"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          tipo_cargo as string,",
						"          estado_pago as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT DISTINCT\\n    LTRIM(RTRIM(charge_type)) AS tipo_cargo,\\n    LTRIM(RTRIM(payment_status)) AS estado_pago\\nFROM silver.billing',",
						"     format: 'query') ~> SourceSilverBilling",
						"SourceSilverBilling sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          servicio_cargo_key as integer,",
						"          tipo_cargo as string,",
						"          estado_pago as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          tipo_cargo,",
						"          estado_pago",
						"     )) ~> SinkGoldDimServicioCargo"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_admissions')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_admissions",
								"type": "DatasetReference"
							},
							"name": "SourceBronzeAdmissions"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_admissions",
								"type": "DatasetReference"
							},
							"name": "SinkSilverAdmissions"
						}
					],
					"transformations": [
						{
							"name": "CleanAndCastAdmissions"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as string,",
						"          patient_id as string,",
						"          admission_date as string,",
						"          discharge_date as string,",
						"          department as string,",
						"          attending_doctor_id as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT a.*\\nFROM bronze.admissions a\\nINNER JOIN silver.patients p ON TRY_CAST(a.patient_id AS INT) = p.patient_id\\nWHERE a.admission_date IS NOT NULL AND LTRIM(RTRIM(a.admission_date)) <> \\'\\'',",
						"     format: 'query') ~> SourceBronzeAdmissions",
						"SourceBronzeAdmissions derive(admission_id = toInteger(admission_id),",
						"          patient_id = toInteger(patient_id),",
						"          admission_date = coalesce(toDate(admission_date, 'yyyy-MM-dd'), toDate(admission_date, 'MM-dd-yy'), toDate(admission_date, 'MM/dd/yyyy'), toDate(admission_date, 'dd-MMM-yyyy'), toDate(admission_date, 'MMMM dd, yyyy')),",
						"          discharge_date = coalesce(toDate(discharge_date, 'yyyy-MM-dd'), toDate(discharge_date, 'MM-dd-yy'), toDate(discharge_date, 'MM/dd/yyyy'), toDate(discharge_date, 'dd-MMM-yyyy'), toDate(discharge_date, 'MMMM dd, yyyy')),",
						"          attending_doctor_id = toInteger(attending_doctor_id)) ~> CleanAndCastAdmissions",
						"CleanAndCastAdmissions sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> SinkSilverAdmissions"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_billing')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_bronze_billing",
								"type": "DatasetReference"
							},
							"name": "SourceBronzeBilling"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_silver_billing",
								"type": "DatasetReference"
							},
							"name": "SinkSilverBilling"
						}
					],
					"transformations": [
						{
							"name": "CleanAndCastBilling"
						}
					],
					"scriptLines": [
						"source(output(",
						"          billing_id as string,",
						"          admission_id as string,",
						"          charge_type as string,",
						"          amount as string,",
						"          payment_status as string,",
						"          payment_date as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT b.*\\nFROM bronze.billing b\\nINNER JOIN silver.admissions a ON TRY_CAST(b.admission_id AS INT) = a.admission_id',",
						"     format: 'query') ~> SourceBronzeBilling",
						"SourceBronzeBilling derive(billing_id = toInteger(billing_id),",
						"          admission_id = toInteger(admission_id),",
						"          amount = coalesce(toDecimal(trim(replace(replace(replace(amount, 'USD', ''), '$', ''), ',', '')), 12, 2), 0.00),",
						"          payment_date = coalesce(toDate(payment_date, 'yyyy-MM-dd'), toDate(payment_date, 'MM-dd-yy'), toDate(payment_date, 'MM/dd/yyyy'), toDate(payment_date, 'dd-MMM-yyyy'), toDate(payment_date, 'MMMM dd, yyyy')),",
						"          charge_type = iif(isNull(charge_type) || trim(charge_type) == '', 'Desconocido', trim(charge_type))) ~> CleanAndCastBilling",
						"CleanAndCastBilling sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          billing_id as integer,",
						"          admission_id as integer,",
						"          charge_type as string,",
						"          amount as decimal(12,2),",
						"          payment_status as string,",
						"          payment_date as date",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          billing_id,",
						"          admission_id,",
						"          charge_type,",
						"          amount,",
						"          payment_status,",
						"          payment_date",
						"     )) ~> SinkSilverBilling"
					]
				}
			},
			"dependsOn": []
		},
