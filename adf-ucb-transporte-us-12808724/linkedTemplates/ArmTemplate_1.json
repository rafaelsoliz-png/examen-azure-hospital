		{
			"name": "[concat(parameters('factoryName'), '/df_gold_fact_admisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_silver_admissions",
								"type": "DatasetReference"
							},
							"name": "SourceFactAdmisiones"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_gold_fact_admisiones",
								"type": "DatasetReference"
							},
							"name": "SinkGoldFactAdmisiones"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    a.admission_id AS admission_id_bk,\\n    dp.paciente_key,\\n    ddep.departamento_key,\\n    dd.diagnostico_key,\\n    dfi.fecha_key AS fecha_ingreso_key,\\n    dfa.fecha_key AS fecha_alta_key,\\n    a.attending_doctor_id AS medico_id,\\n    DATEDIFF(DAY, a.admission_date, a.discharge_date) AS dias_estancia,\\n    1 AS conteo_admisiones\\nFROM silver.admissions a\\nINNER JOIN silver.diagnoses d\\n    ON a.admission_id = d.admission_id\\nINNER JOIN gold.dim_paciente dp\\n    ON a.patient_id = dp.patient_id_bk\\nINNER JOIN gold.dim_departamento ddep\\n    ON LTRIM(RTRIM(a.department)) = ddep.nombre_departamento\\nINNER JOIN gold.dim_diagnostico dd\\n    ON LTRIM(RTRIM(d.icd_code)) = dd.codigo_icd\\n    AND COALESCE(NULLIF(LTRIM(RTRIM(d.severity)), \\'\\'), \\'No Especificado\\') = dd.nivel_severidad\\nINNER JOIN gold.dim_fecha dfi\\n    ON a.admission_date = dfi.fecha_completa\\nLEFT JOIN gold.dim_fecha dfa\\n    ON a.discharge_date = dfa.fecha_completa',",
						"     format: 'query') ~> SourceFactAdmisiones",
						"SourceFactAdmisiones sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admision_key as long,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          admission_id_bk,",
						"          paciente_key,",
						"          departamento_key,",
						"          diagnostico_key,",
						"          fecha_ingreso_key,",
						"          fecha_alta_key,",
						"          medico_id,",
						"          dias_estancia,",
						"          conteo_admisiones",
						"     )) ~> SinkGoldFactAdmisiones"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_fact_facturacion')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_silver_billing",
								"type": "DatasetReference"
							},
							"name": "SourceFactFacturacion"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_gold_fact_facturacion",
								"type": "DatasetReference"
							},
							"name": "SinkGoldFactFacturacion"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          servicio_cargo_key as integer,",
						"          fecha_pago_key as integer,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT\\n    b.billing_id AS billing_id_bk,\\n    b.admission_id AS admission_id_bk,\\n    dp.paciente_key,\\n    ddep.departamento_key,\\n    dsc.servicio_cargo_key,\\n    dfp.fecha_key AS fecha_pago_key,\\n    b.amount AS monto_facturado,\\n    1 AS conteo_transacciones\\nFROM silver.billing b\\nINNER JOIN silver.admissions a\\n    ON b.admission_id = a.admission_id\\nINNER JOIN gold.dim_paciente dp\\n    ON a.patient_id = dp.patient_id_bk\\nINNER JOIN gold.dim_departamento ddep\\n    ON LTRIM(RTRIM(a.department)) = ddep.nombre_departamento\\nINNER JOIN gold.dim_servicio_cargo dsc\\n    ON LTRIM(RTRIM(b.charge_type)) = dsc.tipo_cargo\\n    AND LTRIM(RTRIM(b.payment_status)) = dsc.estado_pago\\nLEFT JOIN gold.dim_fecha dfp\\n    ON b.payment_date = dfp.fecha_completa',",
						"     format: 'query') ~> SourceFactFacturacion",
						"SourceFactFacturacion sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          facturacion_key as long,",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          servicio_cargo_key as integer,",
						"          fecha_pago_key as integer,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          billing_id_bk,",
						"          admission_id_bk,",
						"          paciente_key,",
						"          departamento_key,",
						"          servicio_cargo_key,",
						"          fecha_pago_key,",
						"          monto_facturado,",
						"          conteo_transacciones",
						"     )) ~> SinkGoldFactFacturacion"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/pipeline_gold')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "LimpiarGold",
						"type": "Script",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"linkedServiceName": {
							"referenceName": "ls_sql_dw_hospital",
							"type": "LinkedServiceReference"
						},
						"typeProperties": {
							"scripts": [
								{
									"type": "NonQuery",
									"text": "DELETE FROM gold.fact_facturacion;\nDELETE FROM gold.fact_admisiones;\nDELETE FROM gold.dim_diagnostico;\nDELETE FROM gold.dim_servicio_cargo;\nDELETE FROM gold.dim_departamento;\nDELETE FROM gold.dim_paciente;\nDELETE FROM gold.dim_fecha;"
								}
							],
							"scriptBlockExecutionTimeout": "02:00:00"
						}
					},
					{
						"name": "df_gold_dim_departamento",
						"type": "ExecuteDataFlow",
