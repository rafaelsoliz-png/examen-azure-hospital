						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          patient_id_bk,",
						"          nombre_completo,",
						"          genero,",
						"          fecha_nacimiento,",
						"          rango_etario,",
						"          correo_electronico,",
						"          direccion,",
						"          proveedor_seguro",
						"     )) ~> SinkGoldDimPaciente"
					]
				}
			},
			"dependsOn": [
